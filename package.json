{
  "name": "docuqueue-mcp",
  "version": "0.1.4",
  "description": "MCP server for PDF generation: create invoices, contracts, certificates, forms, and batch documents from Claude, ChatGPT, and Cursor. MIT, hosted or local.",
  "main": "dist/index.js",
  "bin": {
    "docuqueue-mcp": "./dist/index.js",
    "docuqueue-mcp-server": "./dist/remote.js",
    "docuqueue-mcp-install": "./dist/install.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noCheck",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "dev:remote": "tsx watch src/remote.ts",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote.js",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pdf",
    "pdf-generation",
    "html-to-pdf",
    "pdf-form-filling",
    "form-filling",
    "document-generation",
    "invoice",
    "invoice-generator",
    "contract",
    "certificate",
    "batch",
    "templates",
    "claude",
    "chatgpt",
    "cursor",
    "ai",
    "ai-agents",
    "docuqueue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docuqueue/docuqueue-mcp.git"
  },
  "homepage": "https://docuqueue.com/mcp",
  "bugs": {
    "url": "https://github.com/docuqueue/docuqueue-mcp/issues"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "mcpName": "io.github.dvcoolarun/docuqueue-mcp"
}
